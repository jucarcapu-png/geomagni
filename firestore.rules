rules_version = '2';

// Reglas de seguridad de Firestore para las cuentas y licencias de GEOMAGNI.
// Publíquelas en Consola de Firebase › Firestore Database › Reglas.
// Cada persona solo lee y crea sus propios documentos; nadie puede alargar ni cambiar una licencia.
service cloud.firestore {
  match /databases/{base}/documents {

    function propio(uid) { return request.auth != null && request.auth.uid == uid; }
    // Administrador del sitio (WEB-012): panel privado admin.html.
    function admin() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email == 'jucarcapu@gmail.com';
    }
    function texto(v, max) { return v is string && v.size() <= max; }
    function correoAcademico() {
      return request.auth.token.email.matches('.*[.]edu([.][a-z]{2})?$')
        && !request.auth.token.email.matches('.*@(gmail|googlemail|hotmail|outlook|live|msn|yahoo|ymail|icloud|me|mac|aol|proton|protonmail|gmx|zoho|yandex|mail)[.].*');
    }

    // Perfil del usuario (se crea al inscribirse)
    match /usuarios/{uid} {
      allow read: if propio(uid) || admin();
      allow create: if propio(uid)
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.creado == request.time
        && texto(request.resource.data.nombre, 120) && request.resource.data.nombre.size() > 1
        && texto(request.resource.data.empresa, 120) && texto(request.resource.data.cargo, 120)
        && texto(request.resource.data.telefono, 40) && texto(request.resource.data.pais, 80) && texto(request.resource.data.ciudad, 80)
        && request.resource.data.perfil in ['profesional', 'empresa', 'estudiante']
        && (request.resource.data.perfil != 'estudiante' || (
              correoAcademico()
              && texto(request.resource.data.universidad, 160) && texto(request.resource.data.programa, 160)
              && request.resource.data.inicio is timestamp
              && request.resource.data.inicio < request.time
              && request.resource.data.duracionAnios is int
              && request.resource.data.duracionAnios >= 1 && request.resource.data.duracionAnios <= 7))
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'empresa', 'cargo', 'telefono', 'pais', 'ciudad', 'perfil',
                                                  'creado', 'universidad', 'programa', 'inicio', 'duracionAnios']);
      allow update: if propio(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'empresa', 'cargo', 'telefono', 'pais', 'ciudad']);
      allow delete: if false;
    }

    // Licencia de TRAMA: una por cuenta, solo con correo confirmado, no editable.
    // Las licencias de pago (tipo 'pago', con vence, plan y equipos) solo las escribe Firebase
    // (functions/index.js) al confirmarse un pago: las reglas no las permiten desde el navegador.
    match /licencias/{uid} {
      allow read: if propio(uid) || admin();
      // El administrador asigna una licencia de cortesia (tipo 'pago', plan 'cortesia') con su vencimiento
      // y cupo de equipos: extender, reactivar o desactivar (vence = ahora). TRAMA la lee como plan.
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['tipo', 'plan', 'periodo', 'equipos', 'vence', 'creado', 'pedido'])
        && request.resource.data.tipo == 'pago' && request.resource.data.plan == 'cortesia'
        && request.resource.data.vence is timestamp
        && request.resource.data.equipos is int && request.resource.data.equipos >= 1 && request.resource.data.equipos <= 50;
      allow create: if propio(uid)
        && request.auth.token.email_verified == true
        && request.resource.data.creado == request.time
        && (
          // Prueba: vence 7 días después de «creado» (lo calculan la web y TRAMA)
          (request.resource.data.tipo == 'prueba'
            && request.resource.data.keys().hasOnly(['tipo', 'creado']))
          ||
          // Estudiantil: correo institucional; datos iguales a los del perfil; vence en la fecha estimada de grado
          (request.resource.data.tipo == 'estudiante'
            && correoAcademico()
            && request.resource.data.keys().hasOnly(['tipo', 'creado', 'inicio', 'duracionAnios'])
            && get(/databases/$(base)/documents/usuarios/$(uid)).data.perfil == 'estudiante'
            && request.resource.data.inicio == get(/databases/$(base)/documents/usuarios/$(uid)).data.inicio
            && request.resource.data.duracionAnios == get(/databases/$(base)/documents/usuarios/$(uid)).data.duracionAnios
            && request.resource.data.inicio + duration.value(request.resource.data.duracionAnios * 365, 'd') > request.time)
        );
      allow update, delete: if false;
    }

    // Equipos donde se usa TRAMA (LIC-001). Tres textos paralelos separados por «;»:
    // huellas, nombres y desde. Nunca mas equipos que el cupo de la licencia: campo «equipos»
    // de licencias/{uid}, que solo pone el administrador (1 si no existe).
    // TRAMA o «Mi cuenta» desconectan equipos reescribiendo la lista.
    match /equipos/{uid} {
      function cupo() {
        let lic = get(/databases/$(base)/documents/licencias/$(uid)).data;
        return lic.get('equipos', 1);
      }
      function cuantos(s) { return s == '' ? 0 : s.split(';').size(); }
      allow read: if propio(uid) || admin();
      allow create, update: if (propio(uid) || admin())
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['huellas', 'nombres', 'desde'])
        && texto(request.resource.data.huellas, 2000)
        && texto(request.resource.data.nombres, 2000)
        && texto(request.resource.data.desde, 2000)
        && cuantos(request.resource.data.huellas) <= cupo()
        && cuantos(request.resource.data.nombres) == cuantos(request.resource.data.huellas)
        && cuantos(request.resource.data.desde) == cuantos(request.resource.data.huellas);
      allow delete: if false;
    }

    // Mensajes de los formularios del sitio (WEB-010, WEB-014): cualquiera los crea, solo el administrador los lee.
    match /mensajes/{id} {
      allow read, update: if admin();
      allow create: if request.resource.data.keys().hasOnly(['tipo', 'asunto', 'pagina', 'estado', 'creado', 'nombre', 'correo',
                                                              'telefono', 'organizacion', 'servicio', 'area', 'plan', 'mensaje'])
        && request.resource.data.tipo in ['contacto', 'postulacion', 'interes']
        && request.resource.data.estado == 'nuevo'
        && request.resource.data.creado == request.time
        && texto(request.resource.data.asunto, 160) && texto(request.resource.data.pagina, 60)
        && texto(request.resource.data.nombre, 200) && request.resource.data.nombre.size() > 1
        && texto(request.resource.data.correo, 200) && request.resource.data.correo.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && texto(request.resource.data.get('telefono', ''), 200) && texto(request.resource.data.get('organizacion', ''), 200)
        && texto(request.resource.data.get('servicio', ''), 200) && texto(request.resource.data.get('area', ''), 200)
        && texto(request.resource.data.get('plan', ''), 200) && texto(request.resource.data.get('mensaje', ''), 4000);
      allow delete: if admin();
    }

    // Pedidos de compra (PAG-001). El cliente solo crea el suyo, pendiente y con un plan valido;
    // Firebase lo aprueba o rechaza al recibir la confirmacion de la pasarela y compara el valor
    // con precios.json. Nadie puede marcar un pedido como pagado desde el navegador.
    match /pedidos/{id} {
      allow read: if (request.auth != null && resource.data.uid == request.auth.uid) || admin();
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.correo == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'correo', 'plan', 'periodo', 'valor', 'moneda', 'estado', 'creado'])
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.plan in ['profesional', 'empresa']
        && request.resource.data.periodo in ['mensual', 'anual']
        && request.resource.data.valor is int && request.resource.data.valor > 0
        && request.resource.data.moneda == 'COP'
        && request.resource.data.creado == request.time;
      allow update, delete: if false;
    }
  }
}
