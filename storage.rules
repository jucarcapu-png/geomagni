rules_version = '2';

// Reglas de Firebase Storage para los instaladores de TRAMA.
// Publíquelas en Consola de Firebase › Storage › Reglas.
// Solo descarga quien inició sesión, confirmó su correo y tiene una licencia vigente en Firestore.
service firebase.storage {
  match /b/{bucket}/o {

    function licencia() {
      return firestore.get(/databases/(default)/documents/licencias/$(request.auth.uid)).data;
    }
    function licenciaVigente() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/licencias/$(request.auth.uid))
        && (
          (licencia().tipo == 'prueba' && licencia().creado + duration.value(7, 'd') > request.time)
          || (licencia().tipo == 'estudiante'
              && licencia().inicio + duration.value(licencia().duracionAnios * 365, 'd') > request.time)
          || (licencia().tipo == 'pago' && licencia().vence > request.time)
        );
    }

    // WEB-030: lectura cerrada hasta el lanzamiento de la beta, para que nadie descargue la versión de pruebas.
    // Al lanzarla, cambiar «false» por «licenciaVigente()» y publicar de nuevo.
    match /instaladores/{archivo} {
      allow read: if false;
      allow write: if false; // se suben solo desde la consola de Firebase
    }

    // Plataforma de planos (WEB-036): PDF de cada conjunto de un proyecto.
    // Suben administradores y editores del proyecto (Firestore proyectos/{pid}); leen todos sus miembros.
    // Solo PDF, hasta 100 MB por archivo. No se reemplazan ni se borran desde el navegador.
    match /proyectos/{pid}/conjuntos/{cid}/{archivo} {
      function proyecto() {
        return firestore.get(/databases/(default)/documents/proyectos/$(pid)).data;
      }
      function correo() { return request.auth.token.email.lower(); }
      function verificado() { return request.auth != null && request.auth.token.email_verified == true; }
      allow read: if verificado() && correo() in proyecto().correos;
      allow create: if verificado() && resource == null
        && (correo() in proyecto().admins || correo() in proyecto().editores)
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && archivo.matches('.*[.]pdf$');
      allow update, delete: if false;
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
